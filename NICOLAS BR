-- Hub de Testes para Brookhaven - Somente com permissão!
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- Criar GUI
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.Name = "TestHub"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 250, 0, 400)
frame.Position = UDim2.new(0, 10, 0.2, 0)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

local uiCorner = Instance.new("UICorner", frame)
uiCorner.CornerRadius = UDim.new(0, 12)

local layout = Instance.new("UIListLayout", frame)
layout.Padding = UDim.new(0, 6)
layout.FillDirection = Enum.FillDirection.Vertical
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.VerticalAlignment = Enum.VerticalAlignment.Top

-- Botão criador
local function criarBotao(texto, callback)
	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(0, 220, 0, 35)
	btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 18
	btn.Text = texto
	btn.MouseButton1Click:Connect(callback)
	local corner = Instance.new("UICorner", btn)
	corner.CornerRadius = UDim.new(0, 6)
end

-- FLY
local flying = false
local flyConn
criarBotao("Ativar Fly", function()
	flying = not flying
	if flying then
		local hrp = character:WaitForChild("HumanoidRootPart")
		local bv = Instance.new("BodyVelocity", hrp)
		bv.MaxForce = Vector3.new(1, 1, 1) * 1e6
		bv.Velocity = Vector3.zero

		flyConn = RunService.RenderStepped:Connect(function()
			local move = Vector3.zero
			local cam = workspace.CurrentCamera
			if UIS:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0,1,0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0,1,0) end
			bv.Velocity = move.Unit * 100
		end)
	else
		if flyConn then flyConn:Disconnect() end
		local bv = character:FindFirstChild("HumanoidRootPart"):FindFirstChildOfClass("BodyVelocity")
		if bv then bv:Destroy() end
	end
end)

-- SPEED
local speedOn = false
criarBotao("Ativar Speed 1000", function()
	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	if humanoid then
		speedOn = not speedOn
		humanoid.WalkSpeed = speedOn and 1000 or 16
	end
end)

-- MATAR TODOS
criarBotao("Matar Todos", function()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then
			p.Character.Humanoid.Health = 0
		end
	end
end)

-- LEVITAR PORTAS E CARROS
criarBotao("Levitar Objetos", function()
	for _, v in pairs(workspace:GetDescendants()) do
		if v:IsA("Part") and (v.Name:lower():find("door") or v.Name:lower():find("car")) then
			local bp = Instance.new("BodyPosition", v)
			bp.Position = v.Position + Vector3.new(0, 30, 0)
			bp.MaxForce = Vector3.new(1, 1, 1) * 1e6
			delay(2, function() bp:Destroy() end)
		end
	end
end)

-- CARRO MATADOR
criarBotao("Matar com Carro", function()
	for _, v in pairs(workspace:GetDescendants()) do
		if v:IsA("VehicleSeat") then
			for _, p in pairs(Players:GetPlayers()) do
				if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					p.Character.HumanoidRootPart.CFrame = v.CFrame + Vector3.new(0, 2, 0)
				end
			end
		end
	end
end)

-- Matar com Sofá
criarBotao("Sofá Mortal", function()
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj.Name:lower():find("sofa") and obj:IsA("Model") then
			for _, p in pairs(Players:GetPlayers()) do
				if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then
					p.Character.Humanoid:TakeDamage(999999)
				end
			end
		end
	end
end)

-- TOCAR ÁUDIO PERSONALIZADO
criarBotao("Tocar Áudio", function()
	local sound = Instance.new("Sound", workspace)
	sound.SoundId = "rbxassetid://1843530210" -- troque pelo ID desejado
	sound.Volume = 10
	sound:Play()
end)

-- ANTI-VOID
criarBotao("Ativar Anti-Void", function()
	RunService.Stepped:Connect(function()
		if character:FindFirstChild("HumanoidRootPart") then
			if character.HumanoidRootPart.Position.Y < -50 then
				character.HumanoidRootPart.CFrame = CFrame.new(0, 100, 0)
			end
		end
	end)
end)
